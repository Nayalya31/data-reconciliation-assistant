APP_NAME=AI Data Assistant
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_FILE_SIZE=10MB
LOG_LEVEL=INFO

OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_HISTORY_MESSAGES=8

APP_USERNAME=replace_with_private_username
APP_PASSWORD=replace_with_strong_password
SESSION_SECRET=replace_with_long_random_secret
COOKIE_SECURE=false
DATABASE_PATH=storage/app.db
